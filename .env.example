NODE_ENV=development
PORT=3000

# En produccion, usar los datos de conexion del proveedor MySQL.
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASS=
DB_NAME=mygamesearcher

# MySQL local: SSL desactivado por defecto. Para Aiven: DB_SSL=true.
DB_SSL=false
# En Render, cargar aqui el certificado CA de Aiven en formato PEM.
# Admite saltos de linea reales o escritos como \n. No versionar el certificado.
# Si se omite, se usan las CA de confianza predeterminadas de Node.
DB_SSL_CA=

# Configurar un secreto aleatorio propio; nunca versionar el valor real.
JWT_SECRET=
# En produccion, usar el origen HTTPS exacto del frontend en Vercel.
FRONTEND_ORIGIN=http://localhost:5173

# Solo para ejecutar manualmente el seed de administrador.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=EJEMPLO_FICTICIO_REEMPLAZAR
ADMIN_NOMBRE=Administrador
ADMIN_APELLIDO=

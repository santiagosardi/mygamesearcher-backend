NODE_ENV=development
PORT=3000

# En Railway, vincular DB_* con las variables del servicio MySQL.
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASS=
DB_NAME=mygamesearcher

# Configurar un secreto aleatorio propio; nunca versionar el valor real.
JWT_SECRET=
# En Railway, usar el origen HTTPS exacto del frontend en Vercel.
FRONTEND_ORIGIN=http://localhost:5173

# Solo para ejecutar manualmente el seed de administrador.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=EJEMPLO_FICTICIO_REEMPLAZAR
ADMIN_NOMBRE=Administrador
ADMIN_APELLIDO=
